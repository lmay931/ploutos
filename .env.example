# copy to .env (gitignored) and fill in. plain KEY=value lines with no spaces
# around '=' (single quote values if needed) - the slurm scripts load it with
# `set -a; source .env` and core/secrets.py uses python-dotenv
GEMINI_API_KEY=
ALPHA_VANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
TIINGO_API_KEY=
# hugging face read token (llama 3.1 is gated), huggingface_hub picks it up directly
HF_TOKEN=
